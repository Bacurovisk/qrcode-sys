# Postgres (usado pelo docker-compose para criar o container `db`)
POSTGRES_USER=qrcode
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=qrcode

# Local dev: aponta pro Postgres rodando em localhost (ex.: via docker-compose up db)
# Produção: o docker-compose.yml monta esta URL sozinho a partir das vars acima,
# não precisa preencher DATABASE_URL manualmente lá.
DATABASE_URL=postgresql://qrcode:troque-esta-senha@localhost:5432/qrcode

# URL pública canônica (SEO: canonical, Open Graph, robots.txt, sitemap.xml).
# Lida no BUILD (build arg no docker-compose). Vazia = https://qrcode.neojr.com.
# Em dev local pode deixar vazia.
NEXT_PUBLIC_SITE_URL=

# Auth.js
NEXTAUTH_URL=http://localhost:3000
# gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=

# Sal usado para hashear o IP nos eventos de scan (qualquer string aleatória)
SCAN_IP_SALT=troque-este-sal

# Página de doação (/doar) — PayPal (PayPal.me ou link do PayPal Donate)
NEXT_PUBLIC_PAYPAL_DONATE_URL=https://www.paypal.com/donate

# Página de doação (/doar) — Pix. Lidas em runtime (não precisa rebuild).
# Opcional: sem PIX_KEY/PIX_NAME/PIX_CITY a página mostra só o PayPal.
# ATENÇÃO: a chave fica visível pra qualquer um que ler o QR — use uma chave
# aleatória (EVP), nunca CPF ou telefone pessoal.
# PIX_KEY_TYPE: RANDOM | EMAIL | PHONE | CPF | CNPJ (padrão: RANDOM)
PIX_KEY_TYPE=RANDOM
PIX_KEY=
# Nome e cidade do recebedor (máx. 25 e 15 caracteres, acentos são removidos)
PIX_NAME=
PIX_CITY=
# Opcional, máx. 25 caracteres
PIX_DESCRIPTION=qrcode-sys

# Login OAuth — Google
# Crie em https://console.cloud.google.com/apis/credentials ("Create Credentials" >
# "OAuth client ID", tipo "Web application"). Adicione como Authorized redirect URI:
#   {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login OAuth — Microsoft
# Crie em https://portal.azure.com > Microsoft Entra ID > App registrations > New
# registration. Em "Supported account types" escolha "Accounts in any organizational
# directory and personal Microsoft accounts" (pra aceitar outlook.com/hotmail.com além
# de contas corporativas). Em Authentication > Redirect URIs (tipo Web):
#   {NEXTAUTH_URL}/api/auth/callback/azure-ad
# O client secret fica em Certificates & secrets > New client secret.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Cloudflare Turnstile — desafio mostrado quando o rate limit é excedido
# (scans em /r/[slug] ou criação de QR code). Opcional: sem essas duas vars
# preenchidas, quem bater no limite é simplesmente bloqueado (sem desafio).
# Crie um site em https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
