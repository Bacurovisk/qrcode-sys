# Postgres (usado pelo docker-compose para criar o container `db`)
POSTGRES_USER=qrcode
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=qrcode

# Local dev: aponta pro Postgres rodando em localhost (ex.: via docker-compose up db)
# Produção: o docker-compose.yml monta esta URL sozinho a partir das vars acima,
# não precisa preencher DATABASE_URL manualmente lá.
DATABASE_URL=postgresql://qrcode:troque-esta-senha@localhost:5432/qrcode

# Auth.js
NEXTAUTH_URL=http://localhost:3000
# gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=

# Sal usado para hashear o IP nos eventos de scan (qualquer string aleatória)
SCAN_IP_SALT=troque-este-sal

# Botão de doação (PayPal.me ou link do PayPal Donate)
NEXT_PUBLIC_PAYPAL_DONATE_URL=https://www.paypal.com/donate
