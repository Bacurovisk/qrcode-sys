# Postgres (usado pelo docker-compose para criar o container `db`)
POSTGRES_USER=qrcode
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=qrcode

# Local dev: aponta pro Postgres rodando em localhost (ex.: via docker-compose up db)
# Produção: o docker-compose.yml monta esta URL sozinho a partir das vars acima,
# não precisa preencher DATABASE_URL manualmente lá.
DATABASE_URL=postgresql://qrcode:troque-esta-senha@localhost:5432/qrcode

# Auth.js
NEXTAUTH_URL=http://localhost:3000
# gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=

# Sal usado para hashear o IP nos eventos de scan (qualquer string aleatória)
SCAN_IP_SALT=troque-este-sal

# Botão de doação (PayPal.me ou link do PayPal Donate)
NEXT_PUBLIC_PAYPAL_DONATE_URL=https://www.paypal.com/donate

# Login OAuth — Google
# Crie em https://console.cloud.google.com/apis/credentials ("Create Credentials" >
# "OAuth client ID", tipo "Web application"). Adicione como Authorized redirect URI:
#   {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login OAuth — Microsoft
# Crie em https://portal.azure.com > Microsoft Entra ID > App registrations > New
# registration. Em "Supported account types" escolha "Accounts in any organizational
# directory and personal Microsoft accounts" (pra aceitar outlook.com/hotmail.com além
# de contas corporativas). Em Authentication > Redirect URIs (tipo Web):
#   {NEXTAUTH_URL}/api/auth/callback/azure-ad
# O client secret fica em Certificates & secrets > New client secret.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
